# ==============================================================================
# QLIZE | Configuración de Clave de Firma Android (Release / Upload Key)
# ==============================================================================
# Copia este archivo como 'keystore.properties' en esta misma carpeta (android/)
# y completa los datos con las credenciales de tu clave de firma.
# NOTA: 'keystore.properties' está excluido en .gitignore por seguridad.

storeFile=../../qlize-release.keystore
storePassword=TU_KEYSTORE_PASSWORD
keyAlias=TU_KEY_ALIAS
keyPassword=TU_KEY_PASSWORD
