{
  "appId": "com.chochelius.qlize",
  "appName": "QLIZE",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#02040a",
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#02040a"
    }
  },
  "android": {
    "backgroundColor": "#02040a",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
