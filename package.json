{
  "name": "qlize-jump",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "cap:sync": "cap sync android",
    "build:android": "vite build && cap sync android",
    "build:android:bundle": "pwsh -File ./build-android.ps1 -Bundle",
    "build:android:release": "pwsh -File ./build-android.ps1 -Release",
    "android:open": "cap open android",
    "build:windows": "pwsh -File ./build-windows.ps1",
    "build:windows:portable": "pwsh -File ./build-windows.ps1 -Portable",
    "windows:dev": "dotnet run --project windows/QLIZE.Windows.csproj -- --dev",
    "windows:open": "powershell -Command \"Start-Process dist-windows/QLIZE.exe\""
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  }
}
