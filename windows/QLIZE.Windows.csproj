<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QLIZE.Windows</RootNamespace>
    <AssemblyName>QLIZE</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    
    <!-- Metadatos de la Aplicación -->
    <Title>QLIZE | Cyber-Zen Vectorial</Title>
    <Product>QLIZE</Product>
    <Description>QLIZE | Cyber-Zen Vectorial — Port Nativo Portable para Windows</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <!-- Propiedades de Publicación Single-File -->
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Incrustar dist/ automáticamente como EmbeddedResource si existe -->
  <ItemGroup Condition="Exists('..\dist')">
    <EmbeddedResource Include="..\dist\**\*" LogicalName="dist.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
